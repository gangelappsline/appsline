# Copia este archivo como `.env` (o `.env.local`) y completa los valores.
# Vite solo expone al navegador las variables con el prefijo VITE_.

# ---- API del panel (Laravel) ----------------------------------------------
# VITE_API_URL='http://127.0.0.1:8000/api'
VITE_API_URL='https://api.appsline.com.mx/api'

# ---- Firebase Cloud Messaging (notificaciones push web) -------------------
# Firebase Console > Configuración del proyecto > Tus apps > Web > SDK setup.
# Estos valores NO son secretos: viajan en el bundle del navegador.
# La cuenta de servicio (service account) NO va aquí, va en la API.
# Guía completa: docs/API-PUSH.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=appsline.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=appsline.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging > Certificados push web > Clave pública (VAPID)
VITE_FIREBASE_VAPID_KEY=
